# HTTP port the server listens on
PORT=8080

# Directory the daily log files are written to (one <YYYY-MM-DD>.jsonl per day)
LOG_DIR=logs

# Shared secret for the log viewer: /api/v1/webhook/view?key=...
VIEW_API_KEY=change-me-to-a-long-random-string

# Largest request body kept per entry, in bytes (default 1 MiB)
MAX_BODY_BYTES=1048576

# Entries shown per page in the viewer
PAGE_SIZE=20
